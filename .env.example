# Application origin, without a trailing slash.
APP_URL=http://localhost:3000

# Browser-safe Clerk publishable key for the local Clerk development instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only Clerk secret for the same local development instance.
CLERK_SECRET_KEY=sk_test_replace_me

# PostgreSQL runtime connection. Use an isolated development database.
DATABASE_URL=postgresql://user:password@localhost:5432/developer_event_dashboard

# Separate role/connection for explicit migration commands.
MIGRATION_DATABASE_URL=postgresql://migration_user:password@localhost:5432/developer_event_dashboard

# Independent random secret for the scheduled retention endpoint.
CRON_SECRET=replace_with_a_random_secret

# Server-side ingestion emergency switch.
INGESTION_ENABLED=true
